{
  "name": "pokemon-web-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.7.0",
  "scripts": {
    "dev": "concurrently -n api,web -c yellow,cyan \"pnpm:api\" \"pnpm:web\"",
    "web": "vite",
    "api": "cp -n db.seed.json db.json 2>/dev/null; json-server --watch db.json --port 3001 --delay 400 --middlewares server/auth-middleware.cjs",
    "build": "eslint src && tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "api:reset": "cp db.seed.json db.json",
    "lint:security": "eslint --config eslint.security.config.js src",
    "audit:gate": "node scripts/audit-gate.mjs"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@hookform/resolvers": "5.9.1",
    "@mui/icons-material": "7.3.11",
    "@mui/material": "7.3.11",
    "@reduxjs/toolkit": "2.13.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.89.0",
    "react-redux": "9.3.0",
    "react-router": "7.18.4",
    "yup": "1.7.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "concurrently": "9.2.4",
    "eslint": "9.39.4",
    "eslint-plugin-no-unsanitized": "4.1.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "eslint-plugin-security": "4.2.0",
    "globals": "17.13.0",
    "json-server": "0.17.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "6.4.3"
  }
}
